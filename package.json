{
  "name": "vproaudio.github.io",
  "version": "1.0.6",
  "description": "Official website for V PRO AUDIO",
  "main": "index.js",
  "scripts": {
    "clean": "bundle exec jekyll clean",
    "build": "npm run build:css && bundle exec jekyll build",
    "build:css": "node scripts/subset-icons.mjs && tailwindcss -i ./_src/tailwind.css -o ./assets/css/main.css --minify",
    "watch:css": "node scripts/subset-icons.mjs && tailwindcss -i ./_src/tailwind.css -o ./assets/css/main.css --watch",
    "doctor": "bundle exec jekyll doctor",
    "serve": "npm run build:css && bundle exec jekyll serve",
    "test": "npm run build",
    "dev": "npm run build:css && bundle exec jekyll serve --livereload",
    "proof": "bundle exec htmlproofer ./_site --disable-external --enforce-https",
    "version:bump": "node scripts/bump-site-version.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vproaudio/vproaudio.github.io.git"
  },
  "keywords": [],
  "author": "Edwin Vans",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vproaudio/vproaudio.github.io/issues"
  },
  "homepage": "https://github.com/vproaudio/vproaudio.github.io#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "bootstrap-icons": "^1.13.2",
    "subset-font": "^2.9.0"
  }
}
